# =============================================================
# ServiceNow PDI Configuration
# Copy this file to .env and fill in your PDI details
# =============================================================

# Your ServiceNow PDI instance URL (no trailing slash)
SNOW_INSTANCE=https://devXXXXXX.service-now.com

# ServiceNow admin credentials
SNOW_USER=admin
SNOW_PASSWORD=your_pdi_password_here

# Set to 'false' for dry-run mode (logs incidents without creating them in ServiceNow)
SNOW_ENABLED=true

# Traffic generator requests per second (keep low for demo, 1-5)
TRAFFIC_RPS=2
