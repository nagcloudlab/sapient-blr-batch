worker_processes auto;

events {
    worker_connections 1024;
}

http {
    upstream foodexpress_backend {
        # BUG 1: Group name 'appserver' (singular) does not match inventory group 'appservers' (plural)
        {% for host in groups['appserver'] %}
        server {{ hostvars[host]['ansible_host'] }}:{{ app_port }};
        {% endfor %}
    }

    server {
        listen {{ nginx_port }};
        server_name {{ server_name }};

        location /api/ {
            # BUG 2: Upstream name 'foodexpress_api' does not match the upstream block 'foodexpress_backend'
            proxy_pass http://foodexpress_api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_connect_timeout 30s;
            proxy_read_timeout 60s;
        }

        location /health {
            return 200 'OK';
            add_header Content-Type text/plain;
        }
    }
}
