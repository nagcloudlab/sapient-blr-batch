// FoodExpress CI/CD Pipeline
// BUG: Missing agent declaration
pipeline {
    environment {
        DOCKER_REGISTRY = 'registry.foodexpress.in'
        // BUG: IMAGE_TAG hardcoded instead of using build number
        IMAGE_TAG = 'latest'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/foodexpress/app.git'
            }
        }
        stage('Build') {
            steps {
                // BUG: No error handling -- if build fails, pipeline continues
                sh 'mvn clean package -DskipTests'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
        stage('Docker Build') {
            steps {
                sh "docker build -t ${DOCKER_REGISTRY}/order-service:${IMAGE_TAG} ./order-service"
                sh "docker build -t ${DOCKER_REGISTRY}/menu-service:${IMAGE_TAG} ./menu-service"
            }
        }
        stage('Deploy') {
            steps {
                // BUG: kubectl apply without checking if cluster is reachable
                sh 'kubectl apply -f k8s/'
            }
        }
    }
    // BUG: No post block for failure notifications
}
