# FoodExpress Order Service - Dockerfile
# TODO: Complete this multi-stage Dockerfile

# BUG: Using full JDK instead of JRE for runtime (image too large ~600MB)
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
# BUG: Copying everything first defeats layer caching
COPY . .
RUN mvn package -DskipTests

# BUG: Using full JDK image instead of JRE-alpine for runtime
FROM eclipse-temurin:17-jdk
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
# BUG: Running as root (security risk)
EXPOSE 8080
# BUG: No HEALTHCHECK instruction
ENTRYPOINT ["java", "-jar", "app.jar"]
