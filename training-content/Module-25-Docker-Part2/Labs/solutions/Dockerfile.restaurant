# FoodExpress Restaurant Service Dockerfile

# FIX: Using specific version tag for reproducible builds
FROM node:18-alpine

# FIX: Set working directory
WORKDIR /app

# FIX: Copy package files FIRST for better cache utilization
COPY package.json package-lock.json ./

# FIX: Using 'npm ci' for deterministic, clean installs
RUN npm ci --only=production

# FIX: Copy source code AFTER npm ci (cache preserved when only code changes)
COPY . .

# FIX: Correct EXPOSE port -- Restaurant Service runs on 3000
EXPOSE 3000

# FIX: Create and switch to non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# FIX: Exec form CMD for proper signal handling
CMD ["node", "server.js"]

# FIX: Added HEALTHCHECK for orchestrator health monitoring
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1
