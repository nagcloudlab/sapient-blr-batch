// FoodExpress Order Service -- Jenkinsfile (Fixed)

pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
        jdk 'JDK-17'
    }

    // FIX: Added pipeline timeout to prevent builds from hanging forever
    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        APP_NAME = 'order-service'
        // FIX: Using credentials() plugin instead of hardcoded password
        DOCKER_CREDS = credentials('docker-hub-credentials')
    }

    stages {
        stage('Checkout') {
            steps {
                // FIX: Changed branch from 'development' to 'main'
                git branch: 'main',
                    url: 'https://github.com/foodexpress/order-service.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
            post {
                success {
                    // FIX: Archive build artifacts for download/rollback
                    archiveArtifacts artifacts: 'target/*.jar',
                                     fingerprint: true
                }
            }
        }

        // FIX: Added Test stage -- was completely missing!
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    // FIX: Publish test results for tracking
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                // FIX: Tagged with build number for reproducible deployments
                sh "docker build -t ${DOCKER_CREDS_USR}/${APP_NAME}:${BUILD_NUMBER} ."
                sh "docker tag ${DOCKER_CREDS_USR}/${APP_NAME}:${BUILD_NUMBER} ${DOCKER_CREDS_USR}/${APP_NAME}:latest"
                // FIX: Using credentials from Jenkins store
                sh "echo ${DOCKER_CREDS_PSW} | docker login -u ${DOCKER_CREDS_USR} --password-stdin"
                sh "docker push ${DOCKER_CREDS_USR}/${APP_NAME}:${BUILD_NUMBER}"
                sh "docker push ${DOCKER_CREDS_USR}/${APP_NAME}:latest"
            }
        }

        stage('Deploy to Staging') {
            steps {
                sh """
                    ssh deploy@staging-server \
                      'docker pull ${DOCKER_CREDS_USR}/${APP_NAME}:${BUILD_NUMBER} && \
                       docker compose -f /opt/foodexpress/docker-compose.yml up -d order-service'
                """
            }
        }
    }

    // FIX: Added complete post section
    post {
        success {
            slackSend channel: '#deployments',
                      color: 'good',
                      message: "Order Service build #${BUILD_NUMBER} deployed to staging successfully"
        }
        // FIX: Added failure notification
        failure {
            slackSend channel: '#deployments',
                      color: 'danger',
                      message: "Order Service build #${BUILD_NUMBER} FAILED: ${BUILD_URL}"
        }
        // FIX: Added workspace cleanup
        always {
            cleanWs()
        }
    }
}
