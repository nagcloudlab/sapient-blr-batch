# FoodExpress .htaccess
#
# CONTAINS BUGS - Find and fix them!
#
# BUG 1: Missing RewriteEngine On - rewrite rules won't work
# BUG 2: RewriteRule syntax is wrong - missing flags and wrong pattern

# BUG 1: RewriteEngine On is MISSING!
# Without this directive, none of the RewriteRule directives below will work.
# Apache will silently ignore all rewrite rules.

# Redirect HTTP to HTTPS
# BUG 2: Wrong RewriteRule syntax
# - Missing [R=301,L] flags (redirect type and last rule)
# - Pattern should match all requests, not just specific paths
RewriteCond %{HTTPS} off
RewriteRule (.*) https://%{HTTP_HOST}/$1

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Route all requests to index.html (for SPA frontend)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

# Security: Deny access to sensitive files
<FilesMatch "\.(env|log|sql|md)$">
    Require all denied
</FilesMatch>

# Security: Deny access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Custom error pages
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html
ErrorDocument 503 /errors/503.html

# Set default charset
AddDefaultCharset UTF-8

# CORS headers for API
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
