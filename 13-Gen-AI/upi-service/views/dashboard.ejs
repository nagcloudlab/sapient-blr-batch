<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UPI Transaction Service</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f0f2f5; color: #333; }
    .container { max-width: 1100px; margin: 0 auto; padding: 20px; }
    h1 { text-align: center; margin-bottom: 24px; color: #5f259f; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    .card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .card h2 { margin-bottom: 16px; font-size: 1.1rem; color: #5f259f; }
    label { display: block; margin-bottom: 4px; font-size: 0.85rem; font-weight: 600; color: #555; }
    input, select { width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 0.95rem; }
    input:focus, select:focus { outline: none; border-color: #5f259f; }
    button { background: #5f259f; color: #fff; border: none; padding: 12px 24px; border-radius: 6px; cursor: pointer; font-size: 0.95rem; width: 100%; }
    button:hover { background: #4a1d7a; }
    button:disabled { background: #999; cursor: not-allowed; }
    .msg { margin-top: 12px; padding: 12px; border-radius: 6px; font-size: 0.9rem; display: none; }
    .msg.success { background: #d4edda; color: #155724; display: block; }
    .msg.error { background: #f8d7da; color: #721c24; display: block; }
    .msg.info { background: #d1ecf1; color: #0c5460; display: block; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #eee; font-size: 0.88rem; }
    th { background: #f8f9fa; font-weight: 600; color: #555; }
    .badge { padding: 3px 10px; border-radius: 12px; font-size: 0.78rem; font-weight: 600; color: #fff; }
    .badge-success { background: #28a745; }
    .badge-failed { background: #dc3545; }
    .badge-pending { background: #ffc107; color: #333; }
    .badge-processing { background: #17a2b8; }
    .badge-refunded { background: #6c757d; }
    .balance-result { margin-top: 12px; font-size: 1.3rem; font-weight: 700; color: #5f259f; text-align: center; display: none; }
    .balance-name { font-size: 0.9rem; color: #666; font-weight: 400; }
    @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="container">
    <h1>UPI Transaction Service</h1>

    <div class="grid">
      <!-- Pay Form -->
      <div class="card">
        <h2>Send Money</h2>
        <form id="payForm">
          <label>Payer VPA</label>
          <select name="payer_vpa" required>
            <option value="">Select payer...</option>
            <% accounts.forEach(a => { %>
              <option value="<%= a.vpa %>"><%= a.vpa %> (<%= a.name %>) - Rs <%= a.balance.toFixed(2) %></option>
            <% }) %>
          </select>

          <label>Payee VPA</label>
          <select name="payee_vpa" required>
            <option value="">Select payee...</option>
            <% accounts.forEach(a => { %>
              <option value="<%= a.vpa %>"><%= a.vpa %> (<%= a.name %>)</option>
            <% }) %>
          </select>

          <label>Amount (Rs)</label>
          <input type="number" name="amount" min="1" max="100000" step="0.01" placeholder="Enter amount" required>

          <label>Note (optional)</label>
          <input type="text" name="note" placeholder="e.g. Dinner split">

          <button type="submit" id="payBtn">Pay Now</button>
          <div id="payMsg" class="msg"></div>
        </form>
      </div>

      <!-- Balance Checker -->
      <div class="card">
        <h2>Check Balance</h2>
        <form id="balanceForm">
          <label>VPA</label>
          <select name="vpa" required>
            <option value="">Select account...</option>
            <% accounts.forEach(a => { %>
              <option value="<%= a.vpa %>"><%= a.vpa %> (<%= a.name %>)</option>
            <% }) %>
          </select>
          <button type="submit">Check Balance</button>
          <div id="balanceResult" class="balance-result"></div>
          <div id="balanceMsg" class="msg"></div>
        </form>
      </div>
    </div>

    <!-- Transactions Table -->
    <div class="card">
      <h2>Recent Transactions</h2>
      <div style="overflow-x: auto;">
        <table>
          <thead>
            <tr>
              <th>Txn ID</th>
              <th>Payer</th>
              <th>Payee</th>
              <th>Amount</th>
              <th>Note</th>
              <th>Status</th>
              <th>Time</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="txnTable">
            <% if (transactions.length === 0) { %>
              <tr><td colspan="8" style="text-align:center; color:#999; padding:24px;">No transactions yet. Send some money!</td></tr>
            <% } else { %>
              <% transactions.forEach(t => { %>
                <tr>
                  <td style="font-family: monospace; font-size:0.8rem;"><%= t.txn_id %></td>
                  <td><%= t.payer_vpa %></td>
                  <td><%= t.payee_vpa %></td>
                  <td>Rs <%= t.amount.toFixed(2) %></td>
                  <td><%= t.note || '-' %></td>
                  <td>
                    <span class="badge badge-<%= t.status.toLowerCase() %>"><%= t.status %></span>
                  </td>
                  <td style="font-size:0.82rem;"><%= t.created_at %></td>
                  <td>
                    <% if (t.status === 'SUCCESS') { %>
                      <button onclick="refund('<%= t.txn_id %>')" style="width:auto; padding:4px 12px; font-size:0.8rem;">Refund</button>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const payForm = document.getElementById('payForm');
    const payMsg = document.getElementById('payMsg');
    const payBtn = document.getElementById('payBtn');
    const balanceForm = document.getElementById('balanceForm');

    payForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      payMsg.className = 'msg';
      payMsg.style.display = 'none';
      payBtn.disabled = true;
      payBtn.textContent = 'Processing...';

      const data = Object.fromEntries(new FormData(payForm));
      data.amount = parseFloat(data.amount);

      try {
        const res = await fetch('/api/pay', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();

        if (!res.ok) {
          payMsg.className = 'msg error';
          payMsg.textContent = json.error;
        } else {
          payMsg.className = 'msg info';
          payMsg.textContent = `${json.message} (${json.txn_id})`;

          // Poll for final status (max 10 attempts)
          let pollCount = 0;
          const poll = setInterval(async () => {
            pollCount++;
            if (pollCount > 10) {
              clearInterval(poll);
              payMsg.className = 'msg error';
              payMsg.textContent = `Transaction timed out. Check status: ${json.txn_id}`;
              return;
            }
            try {
              const statusRes = await fetch(`/api/txn/${json.txn_id}`);
              const statusJson = await statusRes.json();
              if (statusJson.status === 'SUCCESS' || statusJson.status === 'FAILED') {
                clearInterval(poll);
                if (statusJson.status === 'SUCCESS') {
                  payMsg.className = 'msg success';
                  payMsg.textContent = `Payment successful! Txn: ${json.txn_id}`;
                } else {
                  payMsg.className = 'msg error';
                  payMsg.textContent = `Payment failed. Txn: ${json.txn_id}`;
                }
                setTimeout(() => location.reload(), 1500);
              }
            } catch {
              clearInterval(poll);
              payMsg.className = 'msg error';
              payMsg.textContent = `Polling error. Check status: ${json.txn_id}`;
            }
          }, 1000);
        }
      } catch (err) {
        payMsg.className = 'msg error';
        payMsg.textContent = 'Network error. Please try again.';
      } finally {
        payBtn.disabled = false;
        payBtn.textContent = 'Pay Now';
      }
    });

    balanceForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const vpa = balanceForm.vpa.value;
      const resultEl = document.getElementById('balanceResult');
      const msgEl = document.getElementById('balanceMsg');
      resultEl.style.display = 'none';
      msgEl.className = 'msg';
      msgEl.style.display = 'none';

      try {
        const res = await fetch(`/api/balance/${encodeURIComponent(vpa)}`);
        const json = await res.json();
        if (!res.ok) {
          msgEl.className = 'msg error';
          msgEl.textContent = json.error;
        } else {
          resultEl.textContent = `Rs ${json.balance.toFixed(2)}`;
          const nameSpan = document.createElement('span');
          nameSpan.className = 'balance-name';
          nameSpan.textContent = json.name;
          resultEl.appendChild(document.createElement('br'));
          resultEl.appendChild(nameSpan);
          resultEl.style.display = 'block';
        }
      } catch {
        msgEl.className = 'msg error';
        msgEl.textContent = 'Network error.';
      }
    });

    async function refund(txnId) {
      if (!confirm(`Refund transaction ${txnId}?`)) return;
      try {
        const res = await fetch(`/api/refund/${txnId}`, { method: 'POST' });
        const json = await res.json();
        if (!res.ok) {
          alert(json.error);
        } else {
          alert(`Refund successful! Refund Txn: ${json.refund_txn_id}`);
          location.reload();
        }
      } catch {
        alert('Network error.');
      }
    }
  </script>
</body>
</html>
