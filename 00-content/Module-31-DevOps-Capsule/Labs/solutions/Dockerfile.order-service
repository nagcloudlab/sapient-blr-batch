# FoodExpress Order Service - Dockerfile (Fixed)

# FIX: Multi-stage build with proper layer caching
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
# FIX: Copy pom.xml first for dependency layer caching
COPY pom.xml .
RUN mvn dependency:resolve
COPY src ./src
RUN mvn package -DskipTests

# FIX: Using JRE-alpine for smaller runtime image (~200MB vs ~600MB)
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# FIX: Create and use non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=build /app/target/*.jar app.jar

# FIX: Run as non-root user
USER appuser

EXPOSE 8080

# FIX: Added HEALTHCHECK instruction
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
